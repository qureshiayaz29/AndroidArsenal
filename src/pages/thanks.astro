---
import Layout from '../layouts/Layout.astro';
import SocialShare from '../components/SocialShare.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
---

<Layout
  title={`Thank you — ${site.name}`}
  description="You're officially part of the decision. Help spread the word about Android Arsenal."
  noindex={true}
>
  <div class="site-shell">
    <main class="site-box">
      <div class="thanks">
        <p class="thanks__badge">Response recorded</p>
        <h1 class="thanks__title">Thank you!</h1>
        <p class="thanks__lead">
          You're officially part of the decision. We'll use the community response
          to decide what happens next.
        </p>
        <SocialShare />
        <p class="thanks__back">
          <a href="/">&larr; Back to homepage</a>
        </p>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .thanks {
    padding: 1.5rem;
  }

  .thanks__badge {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--android-green-bright);
    background: rgba(61, 220, 132, 0.12);
    border: 1px solid var(--android-green-dark);
    border-radius: 3px;
  }

  .thanks__title {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--text);
  }

  .thanks__lead {
    color: var(--text-muted);
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .thanks__back {
    margin: 1.25rem 0 0;
    font-size: 0.8125rem;
  }
</style>
