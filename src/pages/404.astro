---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found — Android Arsenal" noindex={true}>
  <div class="site-shell">
    <main class="site-box">
      <div class="not-found">
        <p class="not-found__code" aria-hidden="true">404</p>
        <h1>Page not found</h1>
        <p>The page you're looking for doesn't exist or may have moved.</p>
        <a href="/" class="btn btn--yes">&larr; Back to homepage</a>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .not-found {
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .not-found__code {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--border);
    margin: 0 0 0.5rem;
    line-height: 1;
  }

  .not-found h1 {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }

  .not-found p {
    color: var(--text-muted);
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
  }
</style>
