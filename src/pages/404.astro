---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found — Android Arsenal" noindex={true}>
  <main class="not-found">
    <div class="container not-found__inner">
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1>Page not found</h1>
      <p>The page you're looking for doesn't exist.</p>
      <a href="/" class="btn btn--yes">Back to home</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    min-height: 70dvh;
    display: flex;
    align-items: center;
    padding-block: 4rem;
  }

  .not-found__inner {
    text-align: center;
  }

  .not-found__code {
    font-family: var(--font-mono);
    font-size: 4rem;
    font-weight: 800;
    color: var(--border);
    margin: 0 0 0.5rem;
    line-height: 1;
  }

  .not-found h1 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  .not-found p {
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }
</style>
