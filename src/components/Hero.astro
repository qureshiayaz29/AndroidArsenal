    margin-bottom: 1rem;
  }

  .hero__logo {
    flex-shrink: 0;
  }

  .hero__logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(180deg, var(--android-green) 0%, var(--android-green-dark) 100%);
    border: 1px solid var(--android-green-dark);
    border-radius: var(--radius);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.35) inset,
      1px 1px 3px rgba(0, 0, 0, 0.15);
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.2);
  }

  .hero__titles {
    min-width: 0;
  }

  .hero__url {
    margin: 0 0 0.25rem;
    font-size: 0.6875rem;
    color: var(--text-muted);
