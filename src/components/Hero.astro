<header class="hero" id="top">
  <div class="hero__banner">
    <div class="hero__logo" aria-hidden="true">
      <span class="hero__logo-mark">AA</span>
    </div>
    <div class="hero__titles">
      <p class="hero__url">
        <!-- <a href="https://androidarsenal.com">androidarsenal.com</a> -->
        <span class="badge-new">Poll</span>
      </p>
      <h1 class="hero__title">Android Arsenal</h1>
      <p class="hero__tagline">Should we build it?</p>
    </div>
  </div>

  <p class="hero__prompt">Would you use it?</p>

  <div class="hero__actions" role="group" aria-label="Quick vote">
    <a href="#vote" class="btn btn--yes" data-vote="yes">Yes, build it</a>
    <a href="#vote" class="btn btn--no" data-vote="no">Not for me</a>
  </div>

  <p class="hero__note">We're letting Android developers decide.</p>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-vote]').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.preventDefault();
      const vote = btn.getAttribute('data-vote');
      const formSection = document.getElementById('vote');
      if (!vote || !formSection) return;

      history.replaceState(null, '', `#vote?vote=${vote}`);
      formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.dispatchEvent(new HashChangeEvent('hashchange'));
    });
  });
</script>

