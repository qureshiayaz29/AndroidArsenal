  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--text);
  }

  .hero__tagline {
    font-size: 0.9375rem;
    color: var(--android-green-bright);
    font-weight: 700;
    margin: 0.125rem 0 0;
  }

  .hero__prompt {
    margin: 0 0 0.875rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .hero__note {
    font-size: 0.75rem;
    color: var(--text-muted);
