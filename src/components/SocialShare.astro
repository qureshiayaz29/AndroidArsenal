---
import { site, shareLinks, shareUrl } from '../config/site';

interface Props {
  heading?: string;
  subtext?: string;
  compact?: boolean;
}

const {
  heading = 'Share Android Arsenal',
  subtext = 'Know an Android developer? Send this to them.',
  compact = false,
} = Astro.props;

const shareText = `${site.name} — ${site.tagline} Help Android developers decide.`;

const links = [
  { id: 'whatsapp', label: 'Share on WhatsApp', href: shareLinks.whatsapp(`${shareText} ${shareUrl('whatsapp', 'referral')}`) },
  { id: 'x', label: 'Share on X', href: shareLinks.x(shareText, shareUrl('x')) },
  { id: 'linkedin', label: 'Share on LinkedIn', href: shareLinks.linkedin(shareUrl('linkedin')) },
] as const;

const copyUrl = shareUrl('copy');
---

<div class:list={['share', compact && 'share--compact']}>
  <h2 class="share__heading">{heading}</h2>
  {subtext && <p class="share__subtext">{subtext}</p>}
  <ul class="share__links" role="list">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          data-share={link.id}
        >
          &rarr; {link.label}
        </a>
      </li>
    ))}
    <li>
      <button type="button" class="share__copy" id="copy-link-btn" data-url={copyUrl}>
        &rarr; Copy link
      </button>
    </li>
  </ul>
  <p class="share__status sr-only" id="copy-status" role="status" aria-live="polite" />
</div>

<script>
  const btn = document.getElementById('copy-link-btn');
  const status = document.getElementById('copy-status');

  btn?.addEventListener('click', async () => {
    const url = btn.getAttribute('data-url');
    if (!url) return;

    try {
      await navigator.clipboard.writeText(url);
      if (status) {
        status.textContent = 'Link copied to clipboard.';
        status.classList.remove('sr-only');
        setTimeout(() => {
          status.textContent = '';
          status.classList.add('sr-only');
        }, 3000);
      }
    } catch {
      if (status) {
        status.textContent = 'Could not copy. Please copy the URL from the address bar.';
        status.classList.remove('sr-only');
      }
    }
  });
</script>

<style>
  .share {
    text-align: left;
    padding: 1rem 1.125rem;
    background: var(--bg-inset);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
  }

  .share__heading {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.375rem;
    color: var(--text);
  }

  .share__subtext {
    color: var(--text-muted);
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
  }

  .share__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .share__links li {
    margin: 0.25rem 0;
  }

  .share__links a,
  .share__copy {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--link);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }

  .share__links a:visited,
  .share__copy:visited {
    color: var(--link-visited);
  }

  .share__copy:hover,
  .share__links a:hover {
    color: var(--link-hover);
  }

  .share--compact .share__heading {
    font-size: 0.9375rem;
  }
</style>
