---
import { site } from '../config/site';

const { tallyFormId } = site;
const hasForm = Boolean(tallyFormId);
---

<section class="section vote" id="vote" aria-labelledby="vote-heading">
  <div class="container container--wide">
    <p class="section__label">Tell us</p>
    <h2 class="section__title" id="vote-heading">
      What should Android Arsenal be?
    </h2>
    <p class="section__lead">
      Vote and tell us what you'd want from it. Your email is optional.
    </p>

    {hasForm ? (
      <div class="vote__embed" id="tally-embed-container">
        <iframe
          data-tally-src={`https://tally.so/embed/${tallyFormId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
          loading="lazy"
          width="100%"
          height="400"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="Android Arsenal feedback form"
        />
      </div>
    ) : (
      <div class="tally-placeholder">
        <p>
          Tally form not configured yet.<br />
          Set <code>PUBLIC_TALLY_FORM_ID</code> in your environment.
        </p>
      </div>
    )}
  </div>
</section>

{hasForm && (
  <script
    is:inline
    src="https://tally.so/widgets/embed.js"
  />
)}

<script>
  function getVoteFromHash(): string | null {
    const hash = window.location.hash.slice(1);
    if (!hash) return null;
    const params = new URLSearchParams(hash);
    return params.get('vote');
  }

  function updateTallySrc(vote: string | null) {
    const iframe = document.querySelector<HTMLIFrameElement>(
      'iframe[data-tally-src]',
    );
    if (!iframe) return;

    const base = iframe.getAttribute('data-tally-src') ?? '';
    const url = new URL(base);

    if (vote === 'yes' || vote === 'no') {
      url.searchParams.set('vote', vote);
    }

    const referrer = document.referrer;
    if (referrer) {
      url.searchParams.set('referrer', referrer);
    }

    const src = url.toString();
    iframe.setAttribute('data-tally-src', src);
    iframe.src = src;
  }

  function initTally() {
    const vote = getVoteFromHash();
    updateTallySrc(vote);

    if (typeof window.Tally !== 'undefined') {
      window.Tally.loadEmbeds();
    }
  }

  window.addEventListener('hashchange', () => {
    updateTallySrc(getVoteFromHash());
    if (typeof window.Tally !== 'undefined') {
      window.Tally.loadEmbeds();
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTally);
  } else {
    initTally();
  }
</script>

<style>
  .vote__embed {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    min-height: 400px;
  }

  .vote__embed iframe {
    display: block;
    background: transparent;
  }
</style>
