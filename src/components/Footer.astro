---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <hr class="footer__rule" />
    <p class="footer__copy">
      &copy; {year} <strong>{site.name}</strong> &middot;
      <a href="/privacy">Privacy</a>
    </p>
    <p class="footer__meta">
      Community-driven validation &middot; Best viewed in any modern browser
    </p>
  </div>
</footer>

<style>
  .footer {
    max-width: var(--max-width);
    margin: 0.75rem auto 0;
    padding: 0 0.25rem;
  }

  .footer__inner {
    text-align: center;
  }

  .footer__rule {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 0 0 0.75rem;
  }

  .footer__copy {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0 0 0.25rem;
  }

  .footer__meta {
    font-size: 0.6875rem;
    color: var(--text-muted);
    margin: 0;
    font-style: italic;
  }
</style>
